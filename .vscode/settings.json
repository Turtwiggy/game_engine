{
  // "cmake.configureArgs": ["-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE"],
  "cmake.debugConfig": {
    "args": [
      //
      // "--server",
      // "--server-port=27020",
      // "--headless"
    ]
  },

  "C_Cpp.intelliSenseEngine": "disabled", // use clangd
  // "clangd.path": "C:/Software/msys64/ucrt64/bin/clangd.exe",

  // use this with msvc
  // "cmake.cmakePath": "C:/Program Files/CMake/bin/cmake.exe",
  // "cmake.ctestPath": "C:/Program Files/CMake/bin/ctest.exe",
  // "cmake.cpackPath": "C:/Program Files/CMake/bin/cpack.exe",

  // use this with g++
  // "cmake.cmakePath": "C:/Software/msys64/ucrt64/bin/cmake.exe",
  // "cmake.ctestPath": "C:/Software/msys64/ucrt64/bin/ctest.exe",
  // "cmake.cpackPath": "C:/Software/msys64/ucrt64/bin/cpack.exe",

  "cmake.parallelJobs": 32,
  "cmake.generator": "Ninja",

  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compileCommands": [
    "${workspaceFolder}/build/compile_commands.json"
  ],

  "editor.formatOnSave": true,
  "editor.showUnused": true,
  "editor.showDeprecated": true,
  "search.exclude": {
    "**/*.code-search": true,
    "**/.git": true,
    "**/thirdparty": true,
    "game_defence/**": true,
    "game_defence_tests/**": true,
    "game_networked/**": true,
    "game_roguelike/**": true,
    "gamejam_goblinbrawl/**": true
  },
  "files.exclude": {
    "**/.vs": true,
    "**/.cache": true,
    // "game_3d/**": true,
    // "game_defence/**": true,
    // "game_defence_tests/**": true,
    "game_networked/**": true,
    "game_roguelike/**": true,
    "gamejam_goblinbrawl/**": true
  },
  "editor.bracketPairColorization.enabled": true,

  // "gcovViewer.highlightMissedLines": false,

  "C_Cpp.codeAnalysis.runAutomatically": true,
  "C_Cpp.codeAnalysis.clangTidy.enabled": true,
  "C_Cpp.codeAnalysis.clangTidy.checks.enabled": [
    "clang-analyzer-*",
    "cppcoreguidelines-*",
    "modernize-*",
    "performance-*",
    "portability-*",
    "readability-*",
    "clang-analyzer-security.insecureAPI.rand",
    "cppcoreguidelines-avoid-magic-numbers",
    "modernize-use-trailing-return-type",
    "readability-function-cognitive-complexity",
    "readability-magic-numbers"
  ],
  "C_Cpp.codeAnalysis.clangTidy.checks.disabled": [
    "readability-identifier-length",
    "readability-braces-around-statements",
    "readability-uppercase-literal-suffix",
    "modernize-use-trailing-return-type",
    "cppcoreguidelines-pro-type-union-access",
    "clang-analyzer-deadcode.DeadStores",
    "misc-unused-*"
  ]

  // "C_Cpp.codeAnalysis.clangTidy.useBuildPath": false
  // "editor.guides.bracketPairs": "active",
}
