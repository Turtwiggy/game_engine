{
  "weapon_upgrades": [
    
    // projectile amount
    // { "wb_key": "MEGABULLET",                       "display": "[+BIG BUOYS]", "desc": "Combine all projectiles" },
    { "wb_key": "DOUBLE_PROJECTILES",               "display": "[+2x SHOTS]",  "desc": "" },
    { "wb_key": "SHOOT_BULLETS_OPPOSITE_DIRECTION", "display": "[+OPPOSITE SHOTS]", "desc": "Shoot in the opposite direction." },
   
    // shoot on X effects
    // { "wb_key": "SHOOT_FANFIRE_ON_LAST_BULLET",     "display": "[+FANFIRE]", "desc": "Every X bullets, shoot a fan of bullets" },
    // { "wb_key": "SHOOT_FIREBALL",                   "display": "[+FIREBALL]",  "desc": "Every 5th shot [+fireball]" },
    
    // elemntal bullets
    { "wb_key": "CHANGE_DAMAGE_TO_FIRE",            "display": "[+FIRE SHOTS]", "desc": "", "stats": [
      { "stat": "BULLET_SIZE",      "type": "stat_flat_increase", "value": 26 } 
    ] },
    { "wb_key": "CHANGE_DAMAGE_TO_ICE",            "display": "[+ICE BULLETS]", "desc": "" },

    //
    // various stat changes
    //

    // double clip, double firerate, increase reload
    { "wb_key": "CLIPSIZE_UPGRADE",              "display": "[+FAST UNLOAD MAG]", "desc": "", "stats": [
      { "stat": "WEAPON_CLIP_SIZE",   "type": "stat_percent_increase", "value": 200 }, // rare
      { "stat": "WEAPON_FIRERATE",    "type": "stat_percent_increase", "value": 200 }, // rare
      { "stat": "WEAPON_RELOAD",      "type": "stat_flat_increase", "value": 1 } // increase reload time 2 seconds
    ] },
    // crit
    { "wb_key": "CRIT_UPGRADE",         "display": "[+CRIT]", "desc": "It's getting critical.", "stats": [
      { "stat": "BULLET_CRIT_CHANCE",  "type": "stat_flat_increase", "value": 20 },
      { "stat": "BULLET_CRIT_DAMAGE",  "type": "stat_flat_increase", "value": 50 }
    ] },
    // damage + knockback
    {   "wb_key": "DAMAGE_UPGRADE",            "display": "[+DAMAGE]",  "desc": "", "stats": [
      { "stat": "BULLET_DAMAGE",            "type": "stat_percent_increase", "value": 30 }, // rare
      { "stat": "BULLET_KNOCKBACK",         "type": "stat_flat_increase", "value": 1.0 } // rare
    ] },
    // firerate + reload
    { "wb_key": "FIRERATE_UPGRADE",          "display": "[+FIRERATE]",  "desc": "", "stats": [
      { "stat": "WEAPON_FIRERATE",    "type": "stat_percent_increase", "value": 25 }, // rare
      { "stat": "WEAPON_RELOAD",      "type": "stat_percent_increase", "value": -30 }    // rare
    ] },
    // reload
    // note: this forces your clip size to increase by 1
    // this prevents a clip size of 1 having no reload and effectively just firing every frame.
    // the new limiting factor is firerate.
    { "wb_key": "RELOAD_UPGRADE",          "display": "[+FAST RELOAD]",  "desc": "", "stats": [
      { "stat": "WEAPON_RELOAD",      "type": "stat_percent_increase", "value": -99 },
      { "stat": "WEAPON_CLIP_SIZE",   "type": "stat_flat_increase", "value": 1 }
    ] },

    //
    // only usable by sea turret.
    //
    { "wb_key": "TURRET_FOLLOW_PLAYER",       "display": "[+TURRETS MOVE]", "desc": "",            "limited_to": ["weapon_sea_turret"] },
    { "wb_key": "TURRET_EXPLODE_ON_DEATH",    "display": "[+EXPLODE] [-LIFETIME]", "desc": "", "limited_to": ["weapon_sea_turret"], "stats": [
        { "stat": "BULLET_DAMAGE",      "type": "stat_percent_increase", "value": 50 }, 
        { "stat": "BULLET_LIFETIME",    "type": "stat_percent_increase", "value": -50 }
      ]
    }
  ],

