      "enemies": [
        { "key": "actor_enemy_exploder", "data": { "hp": 90, "max": 5, "num_per_spawn": 3} }, // puffer
        { "key": "actor_enemy_melee_1",  "data": { "hp": 90, "max": 100, "num_per_spawn": 20}}, // horseshoe
        { "key": "actor_enemy_melee_3",  "data": { "hp": 90, "max": 30, "num_per_spawn": 4}},  // redclaw
        { "key": "actor_enemy_projectile", "data": {"hp": 40, "max": 20, "num_per_spawn": 1}}, // archerfish
