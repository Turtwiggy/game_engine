{
  
  //
  // 10 waves with various combinations of the following:
  //   pufferfish (actor_enemy_exploder)
  //   horseshoe crab (actor_enemy_melee_1)
  //   hermit crab (actor_enemy_melee_2)
  //   redclaw crab (actor_enemy_melee_3)
  //   anglerfish (actor_enemy_4)
  //   hogfish (actor_enemy_5)
  //   archerfish (actor_enemy_projectile)
  //   jellyfish (actor_enemy_swarmlord)
  //   sea horse (actor_enemy_charger)
  //   sea urchin (actor_enemy_grower) <1 <5 minutes, 1+ 5+ minutes
  //   oyster (actor_destructable) ( spawns 1 every minute )
  //   boss: (actor_snake) (spawns 1 at 5 minutes)
  //

  "wave_spawner": [
    {
      "name": "wave", "time": { "start": 0, "stop": 1 },
      "enemies": [
        { "key": "actor_enemy_exploder", "data": { "hp": 10, "max": 10, "num_per_spawn": 5} }, // puffer
        { "key": "actor_enemy_melee_1",  "data": { "hp": 10, "max": 20, "num_per_spawn": 5} }, // horseshoe
        { "key": "actor_enemy_4",        "data": { "hp": 25, "max": 10, "num_per_spawn": 4} }  // anglerfish (light source)
      ]
    },
    {
      "name": "wave", "time": { "start": 1, "stop": 2 },
      "enemies": [
        { "key": "actor_enemy_exploder", "data": { "hp": 20, "max": 20, "num_per_spawn": 5}},  // puffer
        { "key": "actor_enemy_melee_1",  "data": { "hp": 20, "max": 20, "num_per_spawn": 5}},  // horseshoe
        { "key": "actor_enemy_melee_2",  "data": { "hp": 20, "max": 20, "num_per_spawn": 8}},  // hermit
        { "key": "actor_enemy_4",        "data": { "hp": 25, "max": 10, "num_per_spawn": 4} }, // anglerfish (light source)
        { "key": "actor_enemy_projectile", "data": {"hp": 15, "max": 2, "num_per_spawn": 1}}   // archerfish
      ]
    },
    {
      "name": "wave", "time": { "start": 2, "stop": 3 },
