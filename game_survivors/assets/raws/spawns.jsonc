        { "key": "actor_enemy_exploder", "data": { "hp": 100, "max": 4, "num_per_spawn": 3} }, // puffer
        { "key": "actor_enemy_melee_1",  "data": { "hp": 100, "max": 100, "num_per_spawn": 10}}, // horseshoe
